# Optional. The app remains fully playable when analytics is not configured.
# Configure these in the hosting environment only after the Privacy page is live.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional. Daybook leaderboards (/daybook). Connect Upstash Redis from the
# Vercel dashboard (Storage) and these are set for you. Without them every
# Daybook game still works; the leaderboard pages say they're switched off.
KV_REST_API_URL=
KV_REST_API_TOKEN=
